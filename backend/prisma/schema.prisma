generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  isActive  Boolean    @default(true)
  isDeleted Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  userRoles UserRole[]
}

model User {
  id                            Int                 @id @default(autoincrement())
  firstName                     String
  lastName                      String
  email                         String              @unique
  phoneNumber                   String?             @unique
  password                      String
  emailVerificationOtpHash      String?
  emailVerificationOtpExpiresAt DateTime?
  passwordResetOtpHash          String?
  passwordResetOtpExpiresAt     DateTime?
  isActive                      Boolean             @default(true)
  isVerified                    Boolean             @default(false)
  isDeleted                     Boolean             @default(false)
  profileImage                  String?
  timezone                      String              @default("Asia/Kolkata")
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
  deletedAt                     DateTime?
  folders                       Folder[]
  chats                         Chat[]
  usageLogs                     UsageLog[]
  subscriptions                 Subscription[]
  userWallet                    UserWallet?
  userRoles                     UserRole[]
  preference                    UserPreference?
  walletTransactions            WalletTransaction[]
}

model UserPreference {
  id                      Int      @id @default(autoincrement())
  userId                  Int      @unique
  user                    User     @relation(fields: [userId], references: [id])
  enableFollowUpQuestions Boolean  @default(true)
  contextMemory           String[] @default([])
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model UserRole {
  id        Int       @id @default(autoincrement())
  userId    Int
  roleId    Int
  user      User      @relation(fields: [userId], references: [id])
  role      Role      @relation(fields: [roleId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([userId, roleId])
}

model UserWallet {
  id                 Int                 @id @default(autoincrement())
  userId             Int                 @unique
  user               User                @relation(fields: [userId], references: [id])
  tokensRemaining    Int                 @default(0)
  tokensUsed         Int                 @default(0)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  walletTransactions WalletTransaction[]
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

model WalletTransaction {
  id          Int                   @id @default(autoincrement())
  userId      Int
  user        User                  @relation(fields: [userId], references: [id])
  walletId    Int
  wallet      UserWallet            @relation(fields: [walletId], references: [id])
  amount      Int
  type        WalletTransactionType
  referenceId String?
  meta        Json?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([userId])
  @@index([walletId])
  @@index([createdAt])
  @@index([referenceId])
}

model Folder {
  id        Int       @id @default(autoincrement())
  name      String
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  chats     Chat[]
}

model Chat {
  id          Int             @id @default(autoincrement())
  title       String?
  userId      Int
  folderId    Int?
  assistantId Int?
  messages    Message[]
  responses   ModelResponse[]
  isPinned    Boolean         @default(false)
  isArchived  Boolean         @default(false)
  isShared    Boolean         @default(false)
  isDeleted   Boolean         @default(false)
  shareId     String?         @unique
  sharedAt    DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  user        User            @relation(fields: [userId], references: [id])
  folder      Folder?         @relation(fields: [folderId], references: [id])
  assistant   Assistant?      @relation(fields: [assistantId], references: [id])
  usageLogs   UsageLog[]

  @@index([userId])
  @@index([folderId])
  @@index([assistantId])
  @@index([userId, createdAt])
}

model Message {
  id             Int             @id @default(autoincrement())
  chatId         Int
  role           MessageRole
  content        String
  chatType       String          @default("STANDARD")
  chat           Chat            @relation(fields: [chatId], references: [id])
  attachments    Attachment[]
  editedFromId   Int?
  editedFrom     Message?        @relation("MessageEdits", fields: [editedFromId], references: [id])
  editedVersions Message[]       @relation("MessageEdits")
  isDeleted      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  modelResponses ModelResponse[]
  usageLogs      UsageLog[]

  @@index([chatId])
  @@index([createdAt])
  @@index([chatId, createdAt])
}

model ModelResponse {
  id               Int            @id @default(autoincrement())
  chatId           Int
  messageId        Int
  modelId          Int
  content          String
  promptTokens     Int            @default(0)
  completionTokens Int            @default(0)
  totalTokens      Int            @default(0)
  status           ResponseStatus @default(PENDING)
  isLiked          Boolean?
  isStarred        Boolean        @default(false)
  chat             Chat           @relation(fields: [chatId], references: [id])
  message          Message        @relation(fields: [messageId], references: [id])
  model            Model          @relation(fields: [modelId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  completedAt      DateTime?

  @@index([chatId])
  @@index([messageId])
  @@index([modelId])
  @@index([status])
  @@index([isStarred])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ModelCapability {
  STANDARD
  DEEP_RESEARCH
  IMAGE_GENERATION
  WEB_SEARCH
  VISION
}

enum ResponseStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
}

model Model {
  id                     Int               @id @default(autoincrement())
  name                   String
  modelProviderId        Int
  externalId             String
  capabilities           ModelCapability[] @default([STANDARD])
  description            String?
  isActive               Boolean           @default(true)
  defaultForCapabilities ModelCapability[] @default([])
  tokenMultiplier        Float             @default(1.0)
  isDeleted              Boolean           @default(false)
  responses              ModelResponse[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  deletedAt              DateTime?
  usageLogs              UsageLog[]
  modelProvider          ModelProvider     @relation(fields: [modelProviderId], references: [id])
  assistants             Assistant[]

  @@unique([modelProviderId, externalId])
}

model Assistant {
  id               Int       @id @default(autoincrement())
  name             String
  slug             String    @unique
  description      String?
  icon             String    @default("Bot") // Lucide icon name
  bgFrom           String?
  bgVia            String?
  bgTo             String?
  bgFromDark       String?
  bgViaDark        String?
  bgToDark         String?
  systemPrompt     String
  defaultModelId   Int?
  temperature      Float     @default(0.7) // OpenRouter supports 0.0 - 2.0
  greeting         String?
  suggestedPrompts Json?
  isActive         Boolean   @default(true)
  isDeleted        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  defaultModel     Model?    @relation(fields: [defaultModelId], references: [id])
  chats            Chat[]
}

model ModelProvider {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  apiKey      String?
  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  models      Model[]
}

model Attachment {
  id                 Int      @id @default(autoincrement())
  messageId          Int?
  fileName           String
  fileUrl            String
  cloudinaryPublicId String?
  mimeType           String
  fileSize           Int
  createdAt          DateTime @default(now())
  message            Message? @relation(fields: [messageId], references: [id])
}

model UsageLog {
  id                       Int             @id @default(autoincrement())
  userId                   Int
  modelId                  Int
  chatId                   Int?
  messageId                Int?
  capability               ModelCapability @default(STANDARD)
  promptTokens             Int
  completionTokens         Int
  totalTokens              Int
  billablePromptTokens     Int             @default(0)
  billableCompletionTokens Int             @default(0)
  billableTotalTokens      Int             @default(0)
  user                     User            @relation(fields: [userId], references: [id])
  model                    Model           @relation(fields: [modelId], references: [id])
  chat                     Chat?           @relation(fields: [chatId], references: [id])
  message                  Message?        @relation(fields: [messageId], references: [id])
  createdAt                DateTime        @default(now())

  @@index([userId])
  @@index([modelId])
  @@index([createdAt])
  @@index([messageId])
  @@index([userId, createdAt])
  @@index([modelId, createdAt])
  @@index([capability, createdAt])
}

model Plan {
  id             Int            @id @default(autoincrement())
  name           String
  monthlyPrice   Decimal
  quarterlyPrice Decimal
  yearlyPrice    Decimal
  tokenLimit     Int //monthly limit
  features       Json
  isActive       Boolean        @default(true)
  isDeleted      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  subscriptions  Subscription[]
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

model Subscription {
  id           Int                @id @default(autoincrement())
  userId       Int
  planId       Int
  status       SubscriptionStatus
  billingCycle SubscriptionCycle
  autoRenew    Boolean            @default(true)
  startedAt    DateTime
  expiresAt    DateTime?
  user         User               @relation(fields: [userId], references: [id])
  plan         Plan               @relation(fields: [planId], references: [id])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}

enum SubscriptionCycle {
  MONTHLY
  YEARLY
  QUARTERLY
}
