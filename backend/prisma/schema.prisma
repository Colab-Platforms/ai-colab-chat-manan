generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  isActive  Boolean    @default(true)
  isDeleted Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  userRoles UserRole[]
}

model User {
  id                            Int                 @id @default(autoincrement())
  firstName                     String
  lastName                      String
  email                         String              @unique
  phoneNumber                   String?             @unique
  password                      String
  authProvider                  AuthProvider        @default(LOCAL)
  googleId                      String?
  emailVerificationOtpHash      String?
  emailVerificationOtpExpiresAt DateTime?
  passwordResetOtpHash          String?
  passwordResetOtpExpiresAt     DateTime?
  isGuideTaken                  Boolean             @default(false)
  isActive                      Boolean             @default(true)
  isVerified                    Boolean             @default(false)
  isDeleted                     Boolean             @default(false)
  profileImage                  String?
  timezone                      String              @default("Asia/Kolkata")
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
  deletedAt                     DateTime?
  folders                       Folder[]
  chats                         Chat[]
  usageLogs                     UsageLog[]
  subscriptions                 Subscription[]
  userWallet                    UserWallet?
  userRoles                     UserRole[]
  preference                    UserPreference?
  walletTransactions            WalletTransaction[]
  contexts                      ContextMemory[]
  payments                      Payment[]
  invoices                      Invoice[]
  supportRequests               SupportRequest[]
  generatedDocuments            GeneratedDocument[]
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

model UserPreference {
  id                      Int      @id @default(autoincrement())
  userId                  Int      @unique
  user                    User     @relation(fields: [userId], references: [id])
  enableFollowUpQuestions Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

enum ContextType {
  GLOBAL
  FOLDER
  CUSTOM
}

enum ContextOrigin {
  USER
  SYSTEM
  DISTILLED
}

model ContextMemory {
  id              Int           @id @default(autoincrement())
  userId          Int
  folderId        Int?
  type            ContextType   @default(CUSTOM)
  origin          ContextOrigin @default(USER)
  sourceChatId    Int?
  title           String
  memory          String
  priority        Int           @default(0)
  isAutoSelected  Boolean       @default(false)
  isAutoGenerated Boolean       @default(false)
  isDeleted       Boolean       @default(false)
  user            User          @relation(fields: [userId], references: [id])
  folder          Folder?       @relation(fields: [folderId], references: [id])
  sourceChat      Chat?         @relation("ContextSourceChat", fields: [sourceChatId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  chatContexts    ChatContext[]

  @@index([userId])
  @@index([folderId])
  @@index([userId, type])
  @@index([sourceChatId])
}

model UserRole {
  id        Int       @id @default(autoincrement())
  userId    Int
  roleId    Int
  user      User      @relation(fields: [userId], references: [id])
  role      Role      @relation(fields: [roleId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([userId, roleId])
}

model UserWallet {
  id                 Int                 @id @default(autoincrement())
  userId             Int                 @unique
  user               User                @relation(fields: [userId], references: [id])
  tokensRemaining    Int                 @default(0)
  tokensUsed         Int                 @default(0)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  walletTransactions WalletTransaction[]
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

model WalletTransaction {
  id          Int                   @id @default(autoincrement())
  userId      Int
  user        User                  @relation(fields: [userId], references: [id])
  walletId    Int
  wallet      UserWallet            @relation(fields: [walletId], references: [id])
  amount      Int
  type        WalletTransactionType
  referenceId String?
  meta        Json?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([userId])
  @@index([walletId])
  @@index([createdAt])
  @@index([referenceId])
}

model Folder {
  id        Int             @id @default(autoincrement())
  name      String
  userId    Int
  user      User            @relation(fields: [userId], references: [id])
  isDeleted Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?
  chats     Chat[]
  contexts  ContextMemory[]
}

model Chat {
  id           Int             @id @default(autoincrement())
  title        String?
  userId       Int
  folderId     Int?
  assistantId  Int?
  modelIds     Int[]
  capability   ModelCapability @default(STANDARD)
  messages     Message[]
  responses    ModelResponse[]
  isPinned     Boolean         @default(false)
  isArchived   Boolean         @default(false)
  isShared     Boolean         @default(false)
  isDeleted    Boolean         @default(false)
  shareId      String?         @unique
  sharedAt     DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  user         User            @relation(fields: [userId], references: [id])
  folder       Folder?         @relation(fields: [folderId], references: [id])
  assistant    Assistant?      @relation(fields: [assistantId], references: [id])
  usageLogs    UsageLog[]
  chatContexts ChatContext[]
  distilledContexts ContextMemory[] @relation("ContextSourceChat")
  distillationJobs   ContextDistillationJob[]
  generatedDocuments GeneratedDocument[]

  @@index([userId])
  @@index([folderId])
  @@index([assistantId])
  @@index([userId, createdAt])
}

model ChatContext {
  id        Int           @id @default(autoincrement())
  chatId    Int
  contextId Int
  chat      Chat          @relation(fields: [chatId], references: [id])
  context   ContextMemory @relation(fields: [contextId], references: [id])
  createdAt DateTime      @default(now())

  @@unique([chatId, contextId])
  @@index([chatId])
  @@index([contextId])
}

enum DistillationStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model ContextDistillationJob {
  id        Int                @id @default(autoincrement())
  chatId    Int
  folderId  Int
  chat      Chat               @relation(fields: [chatId], references: [id])
  status    DistillationStatus @default(PENDING)
  attempts  Int                @default(0)
  lastError String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([status])
  @@index([chatId, status])
}

enum GeneratedDocumentFormat {
  PDF
  DOCX
  PPTX
  XLSX
}

enum GeneratedDocumentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model GeneratedDocument {
  id                 Int                     @id @default(autoincrement())
  userId             Int
  chatId             Int?
  messageId          Int?
  // In compare mode one assistant Message owns several ModelResponse rows, so
  // messageId alone cannot say which model's answer this document came from.
  modelResponseId    Int?
  format             GeneratedDocumentFormat @default(PDF)
  status             GeneratedDocumentStatus @default(PENDING)
  title              String
  prompt             String
  sourceText         String?
  spec               Json?
  theme              String                  @default("professional")
  fileName           String?
  fileUrl            String?
  cloudinaryPublicId String?
  fileSize           Int?
  promptTokens       Int                     @default(0)
  completionTokens   Int                     @default(0)
  attempts           Int                     @default(0)
  lastError          String?
  startedAt          DateTime?
  completedAt        DateTime?
  isDeleted          Boolean                 @default(false)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  deletedAt          DateTime?
  user               User                    @relation(fields: [userId], references: [id])
  chat               Chat?                   @relation(fields: [chatId], references: [id])
  message            Message?                @relation(fields: [messageId], references: [id])
  modelResponse      ModelResponse?          @relation(fields: [modelResponseId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([status, createdAt])
  @@index([chatId])
  @@index([messageId])
  @@index([modelResponseId])
}

model Message {
  id             Int             @id @default(autoincrement())
  chatId         Int
  role           MessageRole
  content        String
  chatType       String          @default("STANDARD")
  chat           Chat            @relation(fields: [chatId], references: [id])
  attachments    Attachment[]
  editedFromId   Int?
  editedFrom     Message?        @relation("MessageEdits", fields: [editedFromId], references: [id])
  editedVersions Message[]       @relation("MessageEdits")
  isDeleted      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  modelResponses ModelResponse[]
  usageLogs      UsageLog[]
  generatedDocuments GeneratedDocument[]

  @@index([chatId])
  @@index([createdAt])
  @@index([chatId, createdAt])
}

model ModelResponse {
  id               Int            @id @default(autoincrement())
  chatId           Int
  messageId        Int
  modelId          Int
  content          String
  promptTokens     Int            @default(0)
  completionTokens Int            @default(0)
  totalTokens      Int            @default(0)
  status           ResponseStatus @default(PENDING)
  finishReason     String?
  isLiked          Boolean?
  isStarred        Boolean        @default(false)
  chat             Chat           @relation(fields: [chatId], references: [id])
  message          Message        @relation(fields: [messageId], references: [id])
  model            Model          @relation(fields: [modelId], references: [id])
  generatedDocuments GeneratedDocument[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  completedAt      DateTime?

  @@index([chatId])
  @@index([messageId])
  @@index([modelId])
  @@index([status])
  @@index([isStarred])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ModelCapability {
  STANDARD
  DEEP_RESEARCH
  IMAGE_GENERATION
  WEB_SEARCH
  VISION
}

enum ResponseStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
}

model Model {
  id                     Int               @id @default(autoincrement())
  name                   String
  modelProviderId        Int
  externalId             String
  capabilities           ModelCapability[] @default([STANDARD])
  description            String?
  isFreeModel            Boolean           @default(false)
  isActive               Boolean           @default(true)
  defaultForCapabilities ModelCapability[] @default([])
  tokenMultiplier        Float             @default(1.0)
  isDeleted              Boolean           @default(false)
  responses              ModelResponse[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  deletedAt              DateTime?
  usageLogs              UsageLog[]
  modelProvider          ModelProvider     @relation(fields: [modelProviderId], references: [id])
  assistants             Assistant[]

  @@unique([modelProviderId, externalId])
}

model Assistant {
  id               Int       @id @default(autoincrement())
  name             String
  slug             String    @unique
  description      String?
  icon             String    @default("Bot") // Lucide icon name
  bgFrom           String?
  bgVia            String?
  bgTo             String?
  bgFromDark       String?
  bgViaDark        String?
  bgToDark         String?
  systemPrompt     String
  defaultModelId   Int?
  temperature      Float     @default(0.7) // OpenRouter supports 0.0 - 2.0
  greeting         String?
  suggestedPrompts Json?
  isActive         Boolean   @default(true)
  isDeleted        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  defaultModel     Model?    @relation(fields: [defaultModelId], references: [id])
  chats            Chat[]
}

model ModelProvider {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  apiKey      String?
  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  models      Model[]
}

model Attachment {
  id                 Int      @id @default(autoincrement())
  messageId          Int?
  fileName           String
  fileUrl            String
  cloudinaryPublicId String?
  mimeType           String
  fileSize           Int
  createdAt          DateTime @default(now())
  message            Message? @relation(fields: [messageId], references: [id])
}

model UsageLog {
  id                       Int             @id @default(autoincrement())
  userId                   Int
  modelId                  Int
  chatId                   Int?
  messageId                Int?
  capability               ModelCapability @default(STANDARD)
  promptTokens             Int
  completionTokens         Int
  totalTokens              Int
  billablePromptTokens     Int             @default(0)
  billableCompletionTokens Int             @default(0)
  billableTotalTokens      Int             @default(0)
  user                     User            @relation(fields: [userId], references: [id])
  model                    Model           @relation(fields: [modelId], references: [id])
  chat                     Chat?           @relation(fields: [chatId], references: [id])
  message                  Message?        @relation(fields: [messageId], references: [id])
  groupId                  String?         @default(cuid())
  createdAt                DateTime        @default(now())

  @@index([userId])
  @@index([modelId])
  @@index([createdAt])
  @@index([messageId])
  @@index([userId, createdAt])
  @@index([modelId, createdAt])
  @@index([capability, createdAt])
  @@index([groupId])
}

model Plan {
  id             Int            @id @default(autoincrement())
  name           String
  monthlyPrice   Decimal
  quarterlyPrice Decimal
  yearlyPrice    Decimal
  tokenLimit     Int //monthly limit
  features       Json
  isActive       Boolean        @default(true)
  isDeleted      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  subscriptions  Subscription[]
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  TRIAL
}

model Subscription {
  id                     Int                @id @default(autoincrement())
  userId                 Int
  planId                 Int
  status                 SubscriptionStatus
  billingCycle           SubscriptionCycle
  autoRenew              Boolean            @default(true)
  startedAt              DateTime
  expiresAt              DateTime?
  cashfreeSubscriptionId String?            @unique
  cashfreeCustomerId     String?
  mandateId              String?
  lastPaymentId          String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  nextBillingDate        DateTime?
  user                   User               @relation(fields: [userId], references: [id])
  plan                   Plan               @relation(fields: [planId], references: [id])
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  payments               Payment[]

  @@index([userId])
  @@index([status])
}

enum SubscriptionCycle {
  MONTHLY
  YEARLY
  QUARTERLY
}

enum SubscriptionReminderStage {
  D3
  D1
  D0
}

model SubscriptionReminder {
  id             Int                       @id @default(autoincrement())
  userId         Int
  subscriptionId Int
  stage          SubscriptionReminderStage
  sentAt         DateTime                  @default(now())
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([subscriptionId, stage])
  @@index([userId, stage])
  @@index([subscriptionId])
}

enum PaymentType {
  ONE_TIME
  RECURRING
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model Payment {
  id                      Int           @id @default(autoincrement())
  userId                  Int
  user                    User          @relation(fields: [userId], references: [id])
  walletId                Int?
  subscriptionId          Int?
  subscription            Subscription? @relation(fields: [subscriptionId], references: [id])
  type                    PaymentType
  provider                String        @default("CASHFREE")
  providerOrderId         String?
  providerPaymentId       String?
  providerSubscriptionId  String?
  amount                  Decimal
  currency                String        @default("INR")
  status                  PaymentStatus @default(PENDING)
  metadata                Json?
  invoice                 Invoice?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@unique([provider, providerPaymentId])
  @@index([userId])
  @@index([providerOrderId])
  @@index([subscriptionId])
}

enum InvoiceStatus {
  PENDING
  GENERATED
  FAILED
}

model Invoice {
  id            Int           @id @default(autoincrement())
  paymentId     Int           @unique
  payment       Payment       @relation(fields: [paymentId], references: [id])
  userId        Int
  user          User          @relation(fields: [userId], references: [id])
  invoiceNumber String        @unique
  invoiceUrl    String?
  amount        Decimal
  currency      String        @default("INR")
  status        InvoiceStatus @default(PENDING)
  errorMessage  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum SupportRequestType {
  TICKET
  CONTACT
}

enum SupportRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportRequest {
  id        Int                   @id @default(autoincrement())
  userId    Int?
  user      User?                 @relation(fields: [userId], references: [id])
  type      SupportRequestType
  name      String
  email     String
  category  String?
  subject   String
  message   String
  status    SupportRequestStatus @default(OPEN)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([email])
}

model BillingWebhookEvent {
  id           Int                @id @default(autoincrement())
  provider     String             @default("CASHFREE")
  eventType    String
  payloadHash  String             @unique
  rawBody      String
  status       WebhookEventStatus @default(RECEIVED)
  errorMessage String?
  processedAt  DateTime?
  createdAt    DateTime           @default(now())

  @@index([eventType])
}
